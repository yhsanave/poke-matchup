    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
    <PackageReference Include="Spectre.Console.Cli.Testing" Version="0.57.2" />
    <PackageReference Include="Spectre.Console.Testing" Version="0.57.2" />
  </ItemGroup>

</Project>
